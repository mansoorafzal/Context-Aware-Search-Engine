{
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft": "Error",
      "Microsoft.AspNetCore": "Warning",
      "index_retrieve": "Information"
    }
  },
  "AllowedHosts": "*",
  "Configurations": {
    "Inter_Services_Pub_Sub_Url": "http://localhost:5081",
    "Http_Client_Request_Timeout_Seconds": 200,
    "Channel_Processing_Capacity": 100,
    "Concurrent_Workers": 15,
    "Maximum_Search_Documents": 10,
    "Concurrent_Search_Requests": 100,
    "Context_Aware_Keywords": [
      "Artificial Intelligence",
      "Machine Learning",
      "Neural Network",
      "Computer Vision",
      "Robotics",
      "AI",
      "ML"
    ],
    "Context_Aware_Title_Reward": 3.0,
    "Context_Aware_Body_Reward": 6.0,
    "Context_Aware_Phrase_Reward": 9.0,
    "Refinements_Enabled": true
  }
}
