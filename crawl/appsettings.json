{
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft": "Error",
      "Microsoft.AspNetCore": "Warning",
      "crawl": "Information"
    }
  },
  "AllowedHosts": "*",
  "Configurations": {
    "Inter_Services_Pub_Sub_Url": "http://localhost:5081",
    "Http_Client_Request_Timeout_Seconds": 200,
    "User_Agent": "case-crawl",
    "Seeds": [
      "https://www.gatech.edu/",
      "https://www.cc.gatech.edu/"
    ],
    "Domain_Scopes": [
      "gatech.edu"
    ],
    "Context_Aware_Body_Keywords": [
      "Artificial Intelligence",
      "Machine Learning",
      "Neural Network",
      "Computer Vision",
      "Robotics",
      "AI",
      "ML"
    ],
    "Context_Aware_Host_Keywords": [
      "ai.gatech.edu",
      "ml.gatech.edu",
      "nec.gatech.edu"
    ],
    "Context_Aware_Body_Reward": 5.0,
    "Context_Aware_Host_Reward": 10.0,
    "Channel_Processing_Capacity": 100,
    "Concurrent_Workers": 15,
    "Bloom_Filter_Capacity": 10000000,
    "Bloom_Filter_False_Positive_Probability": 0.001,
    "Depth_Penalty": 2,
    "Quiescence_Monitor_Enabled": true,
    "Quiescence_Monitor_Shutdown_Seconds": 15,
    "Politeness_Enabled": true,
    "Crawl_Delay_Floor_Seconds": 1,
    "Crawl_Delay_Ceiling_Seconds": 2,
    "Near_Duplicate_Threshold": 2,
    "Refinements_Enabled": true
  }
}
